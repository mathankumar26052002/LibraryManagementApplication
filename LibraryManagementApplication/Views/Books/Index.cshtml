@model List<LibraryManagementMVC.Models.BookViewModel>

<h2>Library Books</h2>

<div class="mb-3">

    <span>
        Welcome,
        <strong>
            @Context.Session.GetString("UserName")
        </strong>
    </span>

    <a asp-controller="Account"
       asp-action="Logout"
       class="btn btn-secondary">
        Logout
    </a>

</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

@if (Context.Session.GetString("Role") == "Admin")
{
    <a asp-controller="Books"
       asp-action="Create"
       class="btn btn-primary mb-3">
        Add Book
    </a>
}

<form asp-controller="Books"
      asp-action="Index"
      method="get"
      class="mb-3">

    <div class="input-group">

        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Search by title, author or genre" />

        <button type="submit"
                class="btn btn-primary">
            Search
        </button>

    </div>

</form>

<table class="table table-bordered">

    <thead>

        <tr>

            <th>Id</th>

            <th>Title</th>

            <th>Author</th>

            <th>Genre</th>

            <th>Availability</th>

            <th>Action</th>

        </tr>

    </thead>

    <tbody>

        @if (Model != null &&
             Model.Any())
        {
            foreach (var book in Model)
            {
                <tr>

                    <td>
                        @book.Id
                    </td>

                    <td>
                        @book.Title
                    </td>

                    <td>
                        @book.Author
                    </td>

                    <td>
                        @book.Genre
                    </td>

                    <td>

                        @if (book.IsAvailable)
                        {
                            <span class="text-success">
                                Available
                            </span>
                        }
                        else
                        {
                            <span class="text-danger">
                                Borrowed
                            </span>
                        }

                    </td>

                    <td>

                        @if (Context.Session.GetString("Role")
                            == "Admin")
                        {
                            <a asp-action="Edit"
                               asp-route-id="@book.Id"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@book.Id"
                                  method="post"
                                  style="display:inline">

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Delete
                                </button>

                            </form>
                        }

                        @if (book.IsAvailable)
                        {
                            <form asp-controller="Borrow"
                                  asp-action="Borrow"
                                  asp-route-bookId="@book.Id"
                                  method="post"
                                  style="display:inline">

                                <button type="submit"
                                        class="btn btn-success btn-sm">
                                    Borrow
                                </button>

                            </form>
                        }
                        else
                        {
                            <form asp-controller="Borrow"
                                  asp-action="Return"
                                  asp-route-bookId="@book.Id"
                                  method="post"
                                  style="display:inline">

                                <button type="submit"
                                        class="btn btn-info btn-sm">
                                    Return
                                </button>

                            </form>
                        }

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6">
                    No books found.
                </td>
            </tr>
        }

    </tbody>

</table>